e >= 0\r\n            then reported_wait_time\r\n        end as valid_open_wait_minutes\r\n    from DENG_ACCELERATOR.TABLES._int_ride_parks\r\n)\r\n\r\nselect\r\n    park_id,\r\n    park_name,\r\n    ride_id,\r\n    ride_name,\r\n    park_local_date,\r\n    avg(valid_open_wait_minutes) as avg_posted_wait_time_when_open,\r\n    sum(valid_open_wait_minutes) as total_valid_open_wait_minutes,\r\n    count(valid_open_wait_minutes) as valid_open_observation_count,\r\n    count(*) as total_observation_count\r\nfrom wait_times\r\ngroup by park_id, park_name, ride_id, ride_name, park_local_date","relation_name":"DENG_ACCELERATOR.TABLES._int_daily_ride_wait","batch_results":null},{"status":"success","timing":[{"name":"compile","started_at":"2026-11-24T16:13:21.083968500Z","completed_at":"2026-11-24T16:13:22.909854300Z"},{"name":"execute","started_at":"2026-11-24T16:13:21.083968500Z","completed_at":"2026-11-24T16:13:22.909854300Z"}],"thread_id":"Thread-1 (worker)","execution_time":1.8258858,"adapter_response":{"_message":"SUCCESS 0","code":"SUCCESS","message":"SUCCESS 0","query_id":"01c8a0ed-0204-353e-001f-4977002e92e6","rows_affected":0},"message":"Succeeded","failures":null,"unique_id":"model.theme_park_waits._fct_daily_park_performance","compiled":null,"compiled_code":"with rides_daily as (\r\n    SELECT *\r\n    FROM DENG_ACCELERATOR.TABLES._int_daily_ride_wait\r\n)\r\n\r\nSELECT\r\npark_id,\r\npark_name,\r\npark_local_date,\r\nsum(total_valid_open_wait_minutes)\r\n        / nullif(sum(valid_open_observation_count), 0)\r\n        as avg_posted_wait_time_when_open,\r\nsum(valid_open_observation_count) as valid_open_observation_count,\r\nsum(total_observation_count) as total_observation_count\r\nfrom rides_daily\r\nGROUP BY park_id, park_name, park_local_date","relation_name":"DENG_ACCELERATOR.TABLES._fct_daily_park_performance","batch_results":null},{"status":"success","timing":[{"name":"compile","started_at":"2026-11-24T16:13:22.949589700Z","completed_at":"2026-11-24T16:13